# ============================================================
# ShopKart — Environment Variables Template
# Copy this file to .env.local and fill in your Supabase values.
# .env.local is git-ignored and must NEVER be committed.
# ============================================================

# Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — safe for frontend use with RLS
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ⚠️  NEVER put the service-role key here.
# The service-role key bypasses all Row Level Security.
# It belongs only on a secure server-side environment.
